{
	"name": "@mohsinonxrm/pptb-fetchxml-studio",
	"version": "1.5.0-beta.18",
	"type": "module",
	"displayName": "FetchXML Studio",
	"description": "A powerful, modern FetchXML query builder and data explorer for Microsoft Dataverse and Dynamics 365.",
	"author": "Mohsin On xRM",
	"main": "index.html",
	"icon": "icons/icon.svg",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohsinonxrm/pptb-mxrm-fetchxml-studio.git"
	},
	"contributors": [
		{
			"name": "Mohsin On xRM",
			"url": "https://github.com/mohsinonxrm"
		},
		{
			"name": "Jonas Rapp",
			"url": "https://github.com/rappen"
		}
	],
	"license": "AGPL-3.0-only",
	"keywords": [
		"powerplatform",
		"dataverse",
		"toolbox",
		"power-apps",
		"dynamics-365",
		"fetchxml",
		"crm",
		"xrm",
		"microsoft"
	],
	"features": {
		"connections": 1,
		"minAPI": "1.2.7"
	},
	"bugs": {
		"url": "https://github.com/mohsinonxrm/pptb-mxrm-fetchxml-studio/issues"
	},
	"configurations": {
		"repository": "https://github.com/mohsinonxrm/pptb-mxrm-fetchxml-studio",
		"website": "https://fetchxml.studio",
		"readmeUrl": "https://raw.githubusercontent.com/mohsinonxrm/pptb-mxrm-fetchxml-studio/refs/heads/main/README.md"
	},
	"files": [
		"dist",
		"index.html",
		"LICENSE",
		"README.md",
		"CHANGELOG.md",
		"SECURITY.md",
		"pptb.config.json"
	],
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26"
	},
	"scripts": {
		"dev": "vite",
		"dev:harness": "vite --mode harness --open",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"lint": "eslint . --max-warnings=0",
		"test": "vitest run",
		"badges": "node .github/scripts/write-badges.mjs",
		"test:watch": "vitest",
		"validate": "pptb-validate",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@fluentui-contrib/react-data-grid-react-window": "^1.4.2",
		"@fluentui/react-calendar-compat": "^0.4.7",
		"@fluentui/react-components": "^9.74.9",
		"@fluentui/react-datepicker-compat": "^0.6.39",
		"@fluentui/react-icons": "2.0.343",
		"@fluentui/react-timepicker-compat": "^0.4.41",
		"@monaco-editor/react": "^4.7.0",
		"exceljs": "^4.4.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-window": "^2.2.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.36.0",
		"@pptb/types": "1.2.7",
		"@types/node": "^24.10.4",
		"@types/react": "^18.3.27",
		"@types/react-dom": "^18.3.7",
		"@types/react-window": "^1.8.8",
		"@vitejs/plugin-react": "^5.2.0",
		"eslint": "^9.39.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.22",
		"globals": "^16.4.0",
		"jsdom": "^30.1.2",
		"monaco-editor": "^0.57.0",
		"prettier": "^3.9.10",
		"scheduler": "^0.27.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^7.3.7",
		"vitest": "^5.0.4"
	},
	"overrides": {
		"exceljs": {
			"uuid": "11.1.1"
		},
		"monaco-editor": {
			"dompurify": "3.4.17"
		}
	}
}
