{
  // Type-checks the dev-only harness (dev/**, #78) as part of `tsc -b`. Nothing is emitted, and
  // dev/ is not a `vite build` input or part of the npm package.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.harness.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["node", "vite/client", "@pptb/types"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["dev"]
}
