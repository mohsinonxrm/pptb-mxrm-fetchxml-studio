exports[`javascript > aggregate-data #1 1`] = `
"// Generated by FetchXML Studio — Code Generation Panel
// Works in Power Apps model-driven app JS / PCF / Dataverse WebAPI

const fetchXml = \`<fetch aggregate='true'>
  <entity name='account'>
    <attribute name='numberofemployees'
      alias='Average'
      aggregate='avg' />
    <attribute name='numberofemployees'
      alias='Count'
      aggregate='count' />
    <attribute name='numberofemployees'
      alias='ColumnCount'
      aggregate='countcolumn' />
    <attribute name='numberofemployees'
      alias='Maximum'
      aggregate='max' />
    <attribute name='numberofemployees'
      alias='Minimum'
      aggregate='min' />
    <attribute name='numberofemployees'
      alias='Sum'
      aggregate='sum' />
  </entity>
</fetch>\`;

Xrm.WebApi.retrieveMultipleRecords("account", "?fetchXml=" + encodeURIComponent(fetchXml))
    .then(function (result) {
        result.entities.forEach(function (record) {
            // Access: record["attribute_name"]
        });
    })
    .catch(function (error) {
        console.error(error.message);
    });"
`;

