exports[`webapi > aggregate-data #1 1`] = `
"// Generated by FetchXML Studio — Code Generation Panel

// ─── OData URL ───────────────────────────────────────────────────────────────
GET https://contoso.crm.dynamics.com/api/data/v9.2/accounts?fetchXml=<url-encoded-xml>

// Full URL (with encoded FetchXML):
https://contoso.crm.dynamics.com/api/data/v9.2/accounts?fetchXml=%3Cfetch%20aggregate%3D%27true%27%3E%3Centity%20name%3D%27account%27%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Average%27%20aggregate%3D%27avg%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Count%27%20aggregate%3D%27count%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27ColumnCount%27%20aggregate%3D%27countcolumn%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Maximum%27%20aggregate%3D%27max%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Minimum%27%20aggregate%3D%27min%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Sum%27%20aggregate%3D%27sum%27%20%2F%3E%3C%2Fentity%3E%3C%2Ffetch%3E

// ─── Headers ─────────────────────────────────────────────────────────────────
OData-MaxVersion: 4.0
OData-Version: 4.0
Accept: application/json
Authorization: Bearer <your-access-token>
// Formatted values, plus the paging cookie and more-records annotations:
Prefer: odata.include-annotations="*"

// ─── Paging (https://learn.microsoft.com/power-apps/developer/data-platform/fetchxml/page-results) ───
// Set count (page size) and page="1" on <fetch>; don't use top with paging.
// While the response has "@Microsoft.Dynamics.CRM.morerecords": true:
//   1. Read the pagingcookie attribute of "@Microsoft.Dynamics.CRM.fetchxmlpagingcookie".
//   2. URL-decode it twice, XML-encode it, and set it as paging-cookie on <fetch>.
//   3. Increment page, URL-encode the FetchXML again, and send the next request.

// ─── cURL ────────────────────────────────────────────────────────────────────
curl -X GET \\
  "https://contoso.crm.dynamics.com/api/data/v9.2/accounts?fetchXml=%3Cfetch%20aggregate%3D%27true%27%3E%3Centity%20name%3D%27account%27%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Average%27%20aggregate%3D%27avg%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Count%27%20aggregate%3D%27count%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27ColumnCount%27%20aggregate%3D%27countcolumn%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Maximum%27%20aggregate%3D%27max%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Minimum%27%20aggregate%3D%27min%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Sum%27%20aggregate%3D%27sum%27%20%2F%3E%3C%2Fentity%3E%3C%2Ffetch%3E" \\
  -H "OData-MaxVersion: 4.0" \\
  -H "OData-Version: 4.0" \\
  -H "Accept: application/json" \\
  -H "Prefer: odata.include-annotations=\\"*\\"" \\
  -H "Authorization: Bearer <your-access-token>"

// ─── PowerShell ──────────────────────────────────────────────────────────────
$headers = @{
    "OData-MaxVersion" = "4.0"
    "OData-Version"    = "4.0"
    "Accept"           = "application/json"
    "Prefer"           = 'odata.include-annotations="*"'
    "Authorization"    = "Bearer <your-access-token>"
}
$url = "https://contoso.crm.dynamics.com/api/data/v9.2/accounts?fetchXml=%3Cfetch%20aggregate%3D%27true%27%3E%3Centity%20name%3D%27account%27%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Average%27%20aggregate%3D%27avg%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Count%27%20aggregate%3D%27count%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27ColumnCount%27%20aggregate%3D%27countcolumn%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Maximum%27%20aggregate%3D%27max%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Minimum%27%20aggregate%3D%27min%27%20%2F%3E%3Cattribute%20name%3D%27numberofemployees%27%20alias%3D%27Sum%27%20aggregate%3D%27sum%27%20%2F%3E%3C%2Fentity%3E%3C%2Ffetch%3E"
$response = Invoke-RestMethod -Method Get -Uri $url -Headers $headers
$response.value"
`;

