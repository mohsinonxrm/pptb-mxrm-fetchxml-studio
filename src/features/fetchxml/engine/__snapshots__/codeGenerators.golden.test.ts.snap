// ─── Headers ─────────────────────────────────────────────────────────────────
OData-MaxVersion: 4.0
OData-Version: 4.0
Accept: application/json
Authorization: Bearer <your-access-token>
// Formatted values, plus the paging cookie and more-records annotations:
Prefer: odata.include-annotations="*"

// ─── Paging (https://learn.microsoft.com/power-apps/developer/data-platform/fetchxml/page-results) ───
// Set count (page size) and page="1" on <fetch>; don't use top with paging.
// While the response has "@Microsoft.Dynamics.CRM.morerecords": true:
//   1. Read the pagingcookie attribute of "@Microsoft.Dynamics.CRM.fetchxmlpagingcookie".
//   2. URL-decode it twice, XML-encode it, and set it as paging-cookie on <fetch>.
//   3. Increment page, URL-encode the FetchXML again, and send the next request.

// ─── cURL ────────────────────────────────────────────────────────────────────
curl -X GET \\
  "https://contoso.crm.dynamics.com/api/data/v9.2/contacts?fetchXml=%3Cfetch%20count%3D%273%27%20page%3D%271%27%3E%3Centity%20name%3D%27contact%27%3E%3Cattribute%20name%3D%27fullname%27%20%2F%3E%3Cattribute%20name%3D%27jobtitle%27%20%2F%3E%3Cattribute%20name%3D%27annualincome%27%20%2F%3E%3Corder%20descending%3D%27true%27%20attribute%3D%27fullname%27%20%2F%3E%3C%2Fentity%3E%3C%2Ffetch%3E" \\
  -H "OData-MaxVersion: 4.0" \\
  -H "OData-Version: 4.0" \\
  -H "Accept: application/json" \\
  -H "Prefer: odata.include-annotations=\\"*\\"" \\
  -H "Authorization: Bearer <your-access-token>"

// ─── PowerShell ──────────────────────────────────────────────────────────────
$headers = @{
    "OData-MaxVersion" = "4.0"
    "OData-Version"    = "4.0"
    "Accept"           = "application/json"
    "Prefer"           = 'odata.include-annotations="*"'
    "Authorization"    = "Bearer <your-access-token>"
}
$url = "https://contoso.crm.dynamics.com/api/data/v9.2/contacts?fetchXml=%3Cfetch%20count%3D%273%27%20page%3D%271%27%3E%3Centity%20name%3D%27contact%27%3E%3Cattribute%20name%3D%27fullname%27%20%2F%3E%3Cattribute%20name%3D%27jobtitle%27%20%2F%3E%3Cattribute%20name%3D%27annualincome%27%20%2F%3E%3Corder%20descending%3D%27true%27%20attribute%3D%27fullname%27%20%2F%3E%3C%2Fentity%3E%3C%2Ffetch%3E"
